<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 hace falta para la sesión de medios del sistema
         (GlobalSystemMediaTransportControlsSessionManager). Pide Windows 10 2004
         o posterior, que es de 2020. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>NubeBar</RootNamespace>
    <AssemblyName>NubeBar</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Sin esto, "un solo fichero" es mentira: las DLL nativas de WPF
         (PresentationNative_cor3, wpfgfx_cor3, D3DCompiler_47_cor3, PenImc_cor3,
         vcruntime140_cor3) y e_sqlite3 se quedan SUELTAS junto al exe, y el exe
         solo, copiado a otra carpeta, muere con DllNotFoundException nada más
         arrancar. El workflow de la Release ya publicaba bien; esto arregla el
         publish local, que es el que va a dist. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Para consultar el índice de Windows Search (Search.CollatorDSO) desde el buscador -->
    <PackageReference Include="ManagedShell" Version="0.0.374" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Slions.VirtualDesktop" Version="6.9.2" />
    <PackageReference Include="System.Data.OleDb" Version="9.0.0" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 hace falta para la sesión de medios del sistema
         (GlobalSystemMediaTransportControlsSessionManager). Pide Windows 10 2004
         o posterior, que es de 2020. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- ManagedShell usa System.Windows.Forms.Screen en su FullScreenHelper (lo
         monta la bandeja). Sin esto no viene en el paquete y salta un
         FileNotFoundException al arrancar. Los using globales de WinForms se
         quitan abajo para que no choquen con los de WPF (Application, Button…). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>NubeBar</RootNamespace>
    <AssemblyName>NubeBar</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <!-- TODO el contenido se extrae a %TEMP%\.net\NubeBar\<id> antes de que arranque
         el runtime, no solo las DLL nativas.

         Con solo las nativas, los ensamblados gestionados se leen del PROPIO EXE a
         medida que hacen falta. Si el exe desaparece a media sesión, la siguiente
         carga tardía muere con FileNotFoundException. Y desaparece en el caso más
         normal del mundo: abrir la descarga desde la barra del navegador. Chrome lo
         ejecuta desde una carpeta temporal suya (%TEMP%\scoped_dir…) y la borra a los
         pocos segundos. Entonces al enfocar la caja del buscador WPF pedía
         UIAutomationProvider (la accesibilidad del foco, que carga tarde), ya no
         había de dónde leerlo, y NubeBar se cerraba de golpe.

         Cuesta medio segundo en el PRIMER arranque de cada versión (700 ms contra
         190 ms); los siguientes van a 90 ms porque la extracción ya está hecha.
         Esto incluye las nativas, así que sustituye a IncludeNativeLibrariesForSelfExtract.
         OJO: AppContext.BaseDirectory pasa a ser la carpeta de extracción, no la del
         exe; para saber dónde está el exe, Environment.ProcessPath. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- ================= El codigo vive en src/ =================

         Los 237 ficheros estaban en la raiz y la portada del repositorio en GitHub era
         una lista de doscientos nombres antes de llegar al README. El SDK los encuentra
         igual esten donde esten (`**/*.cs`), asi que mover no cuesta nada... salvo esto:

         `App.xaml` se marca como ApplicationDefinition —el fichero que genera el Main—
         por un glob que SOLO mira la raiz del proyecto. Fuera de ella pasa a ser un Page
         mas, y entonces el programa se queda sin punto de entrada. Hay que decirlo a
         mano, y quitarlo de los Page para que no entre dos veces. -->
    <ApplicationDefinition Include="src\App.xaml" />
    <Page Remove="src\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Las letras de los temas (fase 6 del rediseno).
         Van como `Resource` y no como `EmbeddedResource`: WPF solo sabe cargar una
         familia desde un `pack://application:,,,/` si esta puesta asi.
         Las seis son OFL; sus licencias viajan al lado, que es lo que la OFL pide.
         Las tres japonesas van RECORTADAS al juego que la interfaz usa: enteras
         pesaban 36 MB de kanji que NubeBar no escribe nunca. -->
    <Resource Include="Fuentes\*.ttf" />
    <None Include="Fuentes\OFL-*.txt" Pack="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los 9 temas de serie del rediseno (docs/REDISENO-VISUAL.md, decision A). Van
         incrustados y no al lado del exe: el exe es de un solo archivo, y un tema de serie
         que se pueda borrar por accidente no es de serie. Los lee `TemasDeSerie`. -->
    <EmbeddedResource Include="temas-de-serie.json" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Para consultar el índice de Windows Search (Search.CollatorDSO) desde el buscador -->
    <PackageReference Include="ManagedShell" Version="0.0.374" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Slions.VirtualDesktop" Version="6.9.2" />
    <PackageReference Include="System.Data.OleDb" Version="9.0.0" />
  </ItemGroup>

</Project>

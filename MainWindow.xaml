<Window x:Class="NubeBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NubeBar" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" Left="0" Top="0" Width="10" Height="10">

    <Window.Resources>
        <SolidColorBrush x:Key="Hover" Color="#30FFFFFF"/>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <!-- Fondo del hover: aparece y desaparece con fundido -->
                            <Border x:Name="bg" Background="{DynamicResource Hover}" CornerRadius="8" Opacity="0"/>
                            <ContentPresenter x:Name="cp" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform/>
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- Al pulsar: se encoge un poco y rebota -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="cp" To="0.82" Duration="0:0:0.08"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                                            <DoubleAnimation Storyboard.TargetName="cp" To="0.82" Duration="0:0:0.08"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="cp" To="1" Duration="0:0:0.35"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="cp" To="1" Duration="0:0:0.35"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- La ventana ocupa todo el ancho y es transparente (los clics la atraviesan);
         la isla se mueve y cambia de tamaño dentro de ella con animaciones -->
    <!-- Opacity=0 de salida: hasta que Aplicar() no ha colocado todo no se dibuja nada,
         y es AnimarAparicion quien la hace entrar. Si no, se ve un fotograma con la
         isla estirada de lado a lado mientras se esconde la barra de Windows. -->
    <!-- La isla es UNA sola superficie de dos filas: arriba los módulos de siempre (alto
         fijo = Barra.Alto) y debajo el "cajón", que mide 0 cuando no hay panel abierto.
         Como el Border recorta a sus bordes, animar Isla.Height hace que el panel se
         despliegue desde dentro de la isla en vez de aparecer como una ventana nueva.
         Con Posicion="abajo" se intercambian las filas (ver ColocarCajon). -->
    <Border x:Name="Isla" Padding="10,0" MinWidth="120" ClipToBounds="True" Opacity="0"
            VerticalAlignment="Top"
            MouseEnter="Isla_MouseEnter" MouseLeave="Isla_MouseLeave"
            MouseRightButtonUp="Isla_Salir" MouseDown="Isla_MouseDown">
        <Grid x:Name="Cuerpo">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FilaIsla" Height="Auto"/>
                <RowDefinition x:Name="FilaCajon" Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="Contenido" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Izq" Grid.Column="0" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel x:Name="Cen" Grid.Column="1" Orientation="Horizontal" Margin="8,0"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel x:Name="Der" Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- El cajón: aquí dentro van la mini lista, la vista general y el menú Inicio -->
            <ContentPresenter x:Name="Cajon" Grid.Row="1"/>
        </Grid>
    </Border>
</Window>
